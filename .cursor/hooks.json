{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "bash scripts/hooks/stop-remember.sh",
        "type": "command",
        "timeout": 30
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "bash scripts/hooks/detect-correction.sh",
        "type": "command",
        "timeout": 5
      }
    ],
    "beforeReadFile": [
      {
        "command": "node scripts/hooks/recall-for-path.js",
        "type": "command",
        "timeout": 10
      }
    ]
  }
}
