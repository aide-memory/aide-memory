{
  "name": "aide-v0",
  "version": "0.2.0",
  "description": "AIDE V0 - Local project-aware AI coding assistant with graph-based retrieval",
  "main": "dist/cli/index.js",
  "bin": {
    "aide": "dist/cli/aide-memory.js",
    "aide-memory": "dist/cli/aide-memory.js",
    "aide-legacy": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "ts-node src/cli/index.ts",
    "build": "tsc",
    "build:dist": "npm run build:dist:cli && npm run build:dist:lib && npm run build:dist:mcp",
    "build:dist:cli": "esbuild src/cli/aide-memory.ts --bundle --platform=node --target=node18 --minify --external:libsql --external:@huggingface/transformers --outfile=dist/cli/aide-memory.js",
    "build:dist:lib": "esbuild src/memory/index.ts --bundle --platform=node --target=node18 --minify --external:libsql --external:@huggingface/transformers --outfile=dist/memory/index.js",
    "build:dist:mcp": "esbuild src/memory/cli.ts --bundle --platform=node --target=node18 --minify --external:libsql --external:@huggingface/transformers --outfile=dist/memory/cli.js",
    "start": "node dist/cli/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --exclude '**/.claude/worktrees/**' --exclude '**/.cursor/worktrees/**'",
    "test:watch": "vitest --exclude '**/.claude/worktrees/**' --exclude '**/.cursor/worktrees/**'",
    "test:smoke": "bash scripts/hooks/__tests__/install-from-tarball.smoke.sh && bash scripts/hooks/__tests__/debug-output-smoke.test.sh && bash scripts/hooks/__tests__/memories-default-shared.smoke.test.sh && bash scripts/hooks/__tests__/semantic-search.smoke.test.sh",
    "test:full": "npm run build && npm run test && npm run build:dist && npm run test:smoke",
    "verify-tarball": "node scripts/verify-package.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "chalk": "^4.1.2",
    "libsql": "^0.5.0",
    "chokidar": "^3.6.0",
    "commander": "^12.0.0",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "ts-morph": "^23.0.0",
    "web-tree-sitter": "^0.25.10",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
